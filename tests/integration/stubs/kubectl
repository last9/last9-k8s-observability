#!/usr/bin/env bash
# kubectl stub for Layer 1 orchestration tests.
# Logs every invocation to $KUBECTL_CALLS_LOG and simulates responses driven
# by env flags so the setup script's control flow can be asserted without a
# real cluster.
#
# Env flags:
#   KUBECTL_CALLS_LOG       file to append each call to (full arg string)
#   SIMULATE_EXISTING_CRDS  "1" → Prometheus CRDs already present on cluster
#   SIMULATE_SCRAPER_HEALTHY / SIMULATE_SCRAPER_SEND_FAILED  "1" → healthy scraper endpoints for verify_metrics_scraper
#   SIMULATE_SCRAPER_FAILED_CONST  "1" -> send_failed counter is non-zero but constant (earlier blip)
#   (sent counter grows on every metrics poll; send_failed grows too when SIMULATE_SCRAPER_SEND_FAILED=1)
#   SIMULATE_KUBELET_ZERO_TARGETS  "1" -> TA kubelet job exists but has no targets
#   SIMULATE_LOCAL_EXPORTER_ONLY  "1" -> only the local prometheus/scrape_health exporter sends; remote write stays at 0
#   SIMULATE_COLLECTOR_PODS  space-separated collector pod names (default last9-otel-metrics-0)
#   SIMULATE_POD_IDS  per-poll collector identities "pod=uid/restarts ...;..." (';' separates polls, last repeats)
#   SIMULATE_TELEMETRY  per-poll remote-write counters "pod=sent,failed ...;..."; "pod=x" -> its :8888 is unreadable
#   (polls are counted by collector pod listings: verify lists pods once per poll)
#   SIMULATE_KSM_ON_POD  pod name that alone scrapes kube-state-metrics (TA assigned it there)
#   SIMULATE_SCRAPES_FAILING  "1" -> collector's local up series are all 0 (e.g. NetworkPolicy blocks scrapes)
#   SIMULATE_KUBELET_SVC / SIMULATE_KUBELET_SVC_MANAGED_BY  orphaned operator kubelet Service in kube-system
#   SIMULATE_PROXY_BLOCKED  "1" -> `get --raw` (apiserver proxy) fails; `port-forward` prints a fake local port
#   SIMULATE_BUNDLED_PROMETHEUS  "1" -> a bundled Prometheus StatefulSet exists in the namespace
#   SIMULATE_PORT_FORWARD_EXITS  "1" -> `port-forward` prints its Forwarding line then exits immediately
#   SIMULATE_EXISTING_OTEL_CRDS  "1" -> OpenTelemetry CRDs already present on cluster
#   MOCK_CONTEXT            value returned by `config current-context`

# Record the full call (including any --context flag the wrapper injected)
[ -n "$KUBECTL_CALLS_LOG" ] && echo "$*" >> "$KUBECTL_CALLS_LOG"

# Strip a leading `--context <value>` so pattern matching sees the real verb
args=("$@")
if [ "${args[0]}" = "--context" ]; then
    args=("${args[@]:2}")
fi
cmd="${args[*]}"

pod_polls="${KUBECTL_CALLS_LOG:-/tmp/kubectl-stub}.pod_polls"
# $1 = "pod=value ...;pod=value ..." (one group per poll, last repeats), $2 = pod. Prints its value this poll.
poll_value() {
    local groups n group kv
    [ -n "$1" ] || return 0
    IFS=';' read -r -a groups <<< "$1"
    n=$(cat "$pod_polls" 2>/dev/null || echo 1)
    [ "$n" -le "${#groups[@]}" ] || n=${#groups[@]}
    group=${groups[$((n - 1))]}
    for kv in $group; do
        [ "${kv%%=*}" = "$2" ] && { echo "${kv#*=}"; return 0; }
    done
}
scripted_telemetry() { [ -z "$SIMULATE_TELEMETRY" ] || poll_value "$SIMULATE_TELEMETRY" "$1"; }
# Pod name of a `port-forward -n <ns> pod/<name> :<port>` call.
pf_pod() { local p=${cmd#*pod/}; echo "${p%% *}"; }

if [ "$SIMULATE_PROXY_BLOCKED" = "1" ] && [[ "$cmd" == "get --raw "* ]]; then
    echo "Error: proxy blocked" >&2
    exit 1
fi

case "$cmd" in
    "config get-contexts "*)
        # Context validation in setup_context_wrappers — always succeeds
        exit 0
        ;;
    "config current-context"*)
        echo "${MOCK_CONTEXT:-test-cluster}"
        exit 0
        ;;
    "get crd alertmanagerconfigs.monitoring.coreos.com"*)
        # Sentinel CRD presence check
        [ "$SIMULATE_EXISTING_CRDS" = "1" ] && exit 0 || exit 1
        ;;
    "get crd -o name"*)
        if [ "$SIMULATE_EXISTING_OTEL_CRDS" = "1" ]; then
            printf '%s\n' \
                "customresourcedefinition.apiextensions.k8s.io/instrumentations.opentelemetry.io" \
                "customresourcedefinition.apiextensions.k8s.io/opentelemetrycollectors.opentelemetry.io"
        fi
        if [ "$SIMULATE_EXISTING_CRDS" = "1" ]; then
            printf '%s\n' \
                "customresourcedefinition.apiextensions.k8s.io/alertmanagerconfigs.monitoring.coreos.com" \
                "customresourcedefinition.apiextensions.k8s.io/prometheuses.monitoring.coreos.com" \
                "customresourcedefinition.apiextensions.k8s.io/servicemonitors.monitoring.coreos.com"
        fi
        exit 0
        ;;
    "cluster-info"*)
        echo "Kubernetes control plane is running at https://stub:6443"
        exit 0
        ;;
    "port-forward "*)
        if [[ "$cmd" == *:8888* ]] && [ "$(scripted_telemetry "$(pf_pod)")" = x ]; then
            echo "error: unable to forward port" >&2
            exit 1
        fi
        # Fake forward: svc/* -> 11111, pod/* -> 22222; stays alive until the script kills it
        case "$cmd" in
            *svc/*) echo "Forwarding from 127.0.0.1:11111 -> 80";;
            *:9465*) echo "Forwarding from 127.0.0.1:33333 -> 9465";;
            *) echo "Forwarding from 127.0.0.1:22222 -> 8888";;
        esac
        [ "$SIMULATE_PORT_FORWARD_EXITS" = "1" ] && exit 0
        exec sleep 30
        ;;
    "get --raw "*"/scrape_configs")
        default_cfg='{"serviceMonitor/last9/last9-k8s-monitoring-kube-state-metrics/0":{},"serviceMonitor/last9/last9-k8s-monitoring-prometheus-node-exporter/0":{},"kubelet":{}}'
        [ "$SIMULATE_SCRAPER_HEALTHY" = "1" ] && echo "${SIMULATE_SCRAPE_CONFIGS:-$default_cfg}"
        exit 0
        ;;
    "get statefulset -n "*" -l operator.prometheus.io/name -o name")
        [ "$SIMULATE_BUNDLED_PROMETHEUS" = "1" ] && echo "statefulset.apps/prom-agent-last9-k8s-monitoring-kube-prometheus"
        exit 0
        ;;
    "get --raw "*"/jobs/kubelet/targets")
        if [ "$SIMULATE_SCRAPER_HEALTHY" = "1" ] && [ "$SIMULATE_KUBELET_ZERO_TARGETS" != "1" ]; then
            echo '[{"targets":["10.0.0.1:10250"],"labels":{"job":"kubelet"}}]'
        else
            echo '[]'
        fi
        exit 0
        ;;
    "get service last9-k8s-monitoring-kube-kubelet -n kube-system"*)
        # SIMULATE_KUBELET_SVC=1 -> our operator-created Service exists; managed-by label from
        # SIMULATE_KUBELET_SVC_MANAGED_BY (default prometheus-operator)
        [ "$SIMULATE_KUBELET_SVC" = "1" ] && echo "${SIMULATE_KUBELET_SVC_MANAGED_BY:-prometheus-operator}"
        exit 0
        ;;
    "get pods -n "*" -l app.kubernetes.io/instance=last9-otel-metrics -o jsonpath="*)
        n=$(( $(cat "$pod_polls" 2>/dev/null || echo 0) + 1 ))
        echo "$n" > "$pod_polls"
        if [[ "$cmd" != *uid* ]]; then
            echo "${SIMULATE_COLLECTOR_PODS:-last9-otel-metrics-0}"
            exit 0
        fi
        # One line per pod: <name>/<uid>/<restartCounts>
        for p in ${SIMULATE_COLLECTOR_PODS:-last9-otel-metrics-0}; do
            id=$(poll_value "$SIMULATE_POD_IDS" "$p")
            echo "$p/${id:-uid-$p/0}"
        done
        exit 0
        ;;
    "get --raw "*":9465/proxy/metrics")
        # Collector's local `up` exporter: one series per core target
        if [ "$SIMULATE_SCRAPER_HEALTHY" = "1" ]; then
            v=1; [ "$SIMULATE_SCRAPES_FAILING" = "1" ] && v=0
            # SIMULATE_KSM_ON_POD: only that pod scrapes kube-state-metrics; the others scrape the rest
            ksm=1 rest=1
            if [ -n "$SIMULATE_KSM_ON_POD" ]; then
                if [[ "$cmd" == *"/pods/$SIMULATE_KSM_ON_POD:"* ]]; then rest=0; else ksm=0; fi
            fi
            [ "$ksm" = 1 ] && echo "up{instance=\"10.0.0.2:8080\",job=\"kube-state-metrics\",namespace=\"last9\"} $v"
            if [ "$rest" = 1 ]; then
                echo "up{instance=\"10.0.0.3:9100\",job=\"node-exporter\",namespace=\"last9\"} $v"
                echo "up{instance=\"10.0.0.1:10250\",job=\"kubelet\",metrics_path=\"/metrics\"} $v"
                echo "up{instance=\"10.0.0.1:10250\",job=\"kubelet\",metrics_path=\"/metrics/cadvisor\"} $v"
            fi
        fi
        exit 0
        ;;
    "get --raw "*"/proxy/metrics")
        if [ -n "$SIMULATE_TELEMETRY" ]; then
            pod=${cmd#*/pods/}; pod=${pod%%:*}
            t=$(scripted_telemetry "$pod")
            if [ "$t" = x ]; then
                echo "Error from server (ServiceUnavailable): 503" >&2
                exit 1
            fi
            echo '# TYPE otelcol_exporter_sent_metric_points_total counter'
            echo "otelcol_exporter_sent_metric_points_total{exporter=\"prometheusremotewrite/last9\"} ${t%,*}"
            echo "otelcol_exporter_send_failed_metric_points_total{exporter=\"prometheusremotewrite/last9\"} ${t#*,}"
        elif [ "$SIMULATE_SCRAPER_HEALTHY" = "1" ]; then
            echo '# TYPE otelcol_exporter_sent_metric_points_total counter'
            poll_file="${KUBECTL_CALLS_LOG:-/tmp/kubectl-stub}.metrics_polls"
            n=0
            [ -f "$poll_file" ] && n=$(cat "$poll_file")
            n=$((n + 1))
            echo "$n" > "$poll_file"
            if [ "$SIMULATE_LOCAL_EXPORTER_ONLY" = "1" ]; then
                echo 'otelcol_exporter_sent_metric_points_total{exporter="prometheusremotewrite/last9"} 0'
                echo "otelcol_exporter_sent_metric_points_total{exporter=\"prometheus/scrape_health\"} $((n * 100))"
            else
                echo "otelcol_exporter_sent_metric_points_total{exporter=\"prometheusremotewrite/last9\"} $((1000 + n * 100))"
            fi
            if [ "$SIMULATE_SCRAPER_SEND_FAILED" = "1" ]; then
                echo "otelcol_exporter_send_failed_metric_points_total{exporter=\"prometheusremotewrite/last9\"} $((n * 5))"
            elif [ "$SIMULATE_SCRAPER_FAILED_CONST" = "1" ]; then
                echo 'otelcol_exporter_send_failed_metric_points_total{exporter="prometheusremotewrite/last9"} 5'
            fi
        fi
        exit 0
        ;;
    "get "*)
        # jsonpath ownership lookups, resource existence checks — return empty/ok
        exit 0
        ;;
    *)
        # create namespace/secret --dry-run, apply, label, annotate, patch, etc.
        exit 0
        ;;
esac
