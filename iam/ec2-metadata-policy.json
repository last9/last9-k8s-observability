{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PromEC2SDDescribeInstances",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "<AWS_REGION>"
        }
      }
    }
  ]
}
